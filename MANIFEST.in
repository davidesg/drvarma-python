# Ship the C engine sources so `pip install` from an sdist can compile it.
recursive-include csrc *.c *.h
include COPYING
include README.md TODO.md
# Se listan por audiencia: guías, referencia de herramientas y formato. STATUS
# y PURE_PYTHON_PLAN son notas de trabajo y dejan de distribuirse.
include docs/USER_GUIDE.md docs/DEVELOPER_GUIDE.md docs/TOOLS.md docs/INP_FORMAT.md
exclude docs/STATUS.md
exclude docs/PURE_PYTHON_PLAN.md
global-exclude *.o *.so
